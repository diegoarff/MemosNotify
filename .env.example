# Secrets referenced by config.yaml via ${ENV} interpolation.
# Tip: any of these can instead be provided as a file path via the <NAME>_FILE
# convention (e.g. TELEGRAM_BOT_TOKEN_FILE=/run/secrets/bot_token) for Docker/k8s secrets.

# Telegram (from @BotFather) and your chat id (from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Memos instance (for archive/complete, deep links, backfill)
MEMOS_BASE_URL=http://memos:5230
MEMOS_TOKEN=

# Optional: path to the config file (defaults to ./config.yaml)
# MEMONUDGE_CONFIG=config.yaml
